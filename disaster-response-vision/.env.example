# Copy to .env and fill in real values. Never commit .env.

# --- Logging ---
LOG_LEVEL=INFO

# --- Paths ---
WEIGHTS_DIR=weights
DATA_DIR=data
RUNS_DIR=runs

# --- Detection ---
DEFAULT_MODEL=yolov8n
CONFIDENCE_THRESHOLD=0.25

# --- Database (SQLAlchemy) ---
# SQLite default — zero setup for local dev:
DATABASE_URL=sqlite:///./data/disaster_vision.db
# PostgreSQL (docker compose / production):
# DATABASE_URL=postgresql+psycopg2://disaster:disaster@localhost:5432/disaster_vision

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Email alerts ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
ALERT_FROM=your-email@gmail.com
ALERT_TO=alerts-recipient@example.com
ALERT_DEDUP_SECONDS=300
